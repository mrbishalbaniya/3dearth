# Server
APP_ENV=development
APP_NAME=orbit-earth-backend
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL + PostGIS
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit?sslmode=disable
DB_MAX_CONNS=50
DB_MIN_CONNS=5

# Redis (use "memory" for in-process miniredis when Docker Redis isn't available)
REDIS_URL=memory

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Multiplayer
WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTEREST_RADIUS_M=50000
MAX_WS_CONNECTIONS=100000
WS_HEARTBEAT_INTERVAL=15s

# Cloudflare R2 (optional)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=orbit-assets

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_PATH=/metrics
LOG_LEVEL=info
